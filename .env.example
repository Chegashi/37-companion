# Copy to .env.local and fill in (`make run` does the copy and generates SECRET_KEY for you).
# Never commit .env.local.

# --- 42 OAuth app (required) ------------------------------------------------------------------
# Create one at https://profile.intra.42.fr/oauth/applications/new
# Its redirect URI must be exactly INTRA_REDIRECT_URI below (your public URL + /api/auth).
INTRA_UID=
INTRA_SECRET_KEY=
INTRA_REDIRECT_URI=http://localhost:3000/api/auth
INTRA_TOKEN=https://api.intra.42.fr

# --- Session (required) -----------------------------------------------------------------------
# Signs the session cookie and encrypts the 42 token inside it. At least 32 random characters:
#   openssl rand -hex 32
SECRET_KEY=

# --- Database ---------------------------------------------------------------------------------
# Used by `npm run dev` / `make dev` (the db container, published on localhost:5433).
# Inside Docker Compose the app is pointed at the db container automatically.
DATABASE_KEY=postgresql://companion:companion@localhost:5433/companion

# --- Optional: local workspace (self-hosting on your own machine only) --------------------------
# The folder holding your 42 project folders (and a subjects/ folder of PDFs). Leave unset on a
# shared deployment: it lets the app read and create folders on the server.
# WORKSPACE_DIR=/Users/you/42
